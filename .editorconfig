root = true

[*.ps1]
# Windows PowerShell 5.1 needs a BOM to read non-ASCII paths as UTF-8.
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false
