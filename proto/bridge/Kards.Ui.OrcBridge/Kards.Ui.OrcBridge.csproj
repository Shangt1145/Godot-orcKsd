<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Engine checkout root. The UI never copies engine sources; it references that checkout.
    Override with: dotnet build -p:OrcEngineRoot=...
    Default points at the dedicated GitHub checkout. Its exact revision and pre-existing local
    changes are recorded in docs/ENGINE_INTEGRATION_BASELINE.md; it is not assumed to be clean.
  -->
  <PropertyGroup>
    <OrcEngineRoot Condition="'$(OrcEngineRoot)' == ''">H:\Working Folder\OrC-KSD-github\src\Orc.Game</OrcEngineRoot>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/verified-cards.json" LogicalName="Kards.Ui.OrcBridge.verified-cards.json" />
    <ProjectReference Include="../../core/Kards.Ui.Core.csproj" />
    <ProjectReference Include="$(OrcEngineRoot)/Orc.Game.csproj" />
  </ItemGroup>
</Project>
