<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Engine checkout root. The UI never copies engine sources; it references that checkout.

    解析顺序（任何人 clone 本仓库都不用改文件）：
      1. dotnet build -p:OrcEngineRoot=<引擎>/src/Orc.Game
      2. 环境变量 ORC_ENGINE_ROOT=<引擎仓库根>（tools/*.ps1 用的就是这个）
      3. 同级目录约定：<本仓库上级>/OrC-KSD/src/Orc.Game 或 .../OrC-KSD-github/src/Orc.Game

    此前这里写死成本机绝对路径（H:\Working Folder\OrC-KSD-github\src\Orc.Game），
    引擎开发者 clone 下来直接构建失败——2026-10-24 反馈。
    找不到工程时由 VerifyOrcEngineRoot 给出明确提示，而不是让 ProjectReference 静默报错。
  -->
  <PropertyGroup>
    <OrcEngineRoot Condition="'$(OrcEngineRoot)' == '' and '$(ORC_ENGINE_ROOT)' != ''">$(ORC_ENGINE_ROOT)/src/Orc.Game</OrcEngineRoot>
    <!-- 先认 -github 后缀：本机同时存在 OrC-KSD（旧基线）与 OrC-KSD-github（工作副本）时，后者才是对的。 -->
    <OrcEngineRoot Condition="'$(OrcEngineRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../../../../OrC-KSD-github/src/Orc.Game/Orc.Game.csproj')">$(MSBuildThisFileDirectory)../../../../OrC-KSD-github/src/Orc.Game</OrcEngineRoot>
    <OrcEngineRoot Condition="'$(OrcEngineRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../../../../OrC-KSD/src/Orc.Game/Orc.Game.csproj')">$(MSBuildThisFileDirectory)../../../../OrC-KSD/src/Orc.Game</OrcEngineRoot>
    <OrcEngineRoot Condition="'$(OrcEngineRoot)' == ''">$(MSBuildThisFileDirectory)../../../../OrC-KSD/src/Orc.Game</OrcEngineRoot>
  </PropertyGroup>

  <Target Name="VerifyOrcEngineRoot" BeforeTargets="PrepareForBuild;ResolveProjectReferences">
    <Error Condition="!Exists('$(OrcEngineRoot)/Orc.Game.csproj')" Code="ORC001"
           Text="找不到引擎工程：$(OrcEngineRoot)/Orc.Game.csproj。三种解决办法（任选其一）：① 设环境变量 ORC_ENGINE_ROOT 指向引擎仓库根目录；② dotnet build -p:OrcEngineRoot=&lt;引擎仓库&gt;/src/Orc.Game；③ 把引擎仓库克隆到本仓库的同级目录并命名 OrC-KSD。" />
  </Target>

  <ItemGroup>
    <!-- 中立 UI 契约（view 三件）：全局导入，保持源码零改动。 -->
    <Using Include="Orc.UI.Contracts" />
    <EmbeddedResource Include="Resources/verified-cards.json" LogicalName="Kards.Ui.OrcBridge.verified-cards.json" />
    <!-- 测试直测转换器的拒绝分支（块级 condition 等无法经公开准入面触发的形状）。 -->
    <InternalsVisibleTo Include="Kards.Ui.Tests" />
    <EmbeddedResource Include="DesktopAuthoring/**/*" Exclude="DesktopAuthoring/css/**;DesktopAuthoring/*.html;DesktopAuthoring/*.cjs;DesktopAuthoring/workbench.js;DesktopAuthoring/js/effect-editor.js;DesktopAuthoring/js/inspector-help.js" LogicalName="Kards.Ui.Desktop.%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Runtime assets, embedded so Godot's in-memory assembly loading needs no Assembly.Location. -->
    <EmbeddedResource Include="$(OrcEngineRoot)/EffectParsing/Templates/ops/*.csx.tpl" LogicalName="Kards.Ui.OrcBridge.DiyOps.%(Filename)%(Extension)" />
    <!-- OrC 导入：引擎触发模板（effectHost 语义原版，31 张）——模板 id 与 DslEffectInstance 对齐。 -->
    <EmbeddedResource Include="$(OrcEngineRoot)/EffectParsing/Templates/*.tpl.json" LogicalName="Kards.Ui.OrcBridge.OrcTpl.%(Filename)%(Extension)" />
    <ProjectReference Include="../../core/Kards.Ui.Core.csproj" />
    <ProjectReference Include="$(OrcEngineRoot)/Orc.Game.csproj" />
    <!-- 迁移 S8：宿主/包管理（EngineHost / CardPackLoader）、脚本求值器与内置 UI 插件（投影提供者）。 -->
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Script/Orc.Script.csproj" />
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Packages/Orc.Packages.csproj" />
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Plugins.BuiltIn/Orc.Plugins.BuiltIn.csproj" />
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.UI/Orc.UI.csproj" />
    <!-- S2 动作实现集：建对局前必须有默认实现，否则 CommandManager 构造即抛。 -->
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Foundation.Actions/Orc.Foundation.Actions.csproj" />
    <!-- 引擎启发式 AI（AiPilot/HeuristicPolicy）：对手驱动的主决策来源。 -->
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Ai/Orc.Ai.csproj" />
    <!-- 联机：OrcClient（TCP/NDJSON JSON-RPC）+ ServerProcess（拉起本地服务端）。
         注意这条不改单机路径——单机仍走进程内引擎，只有联机模式才用到它。
         PrivateAssets="all"：**不把引擎程序集传递进 UI 程序集的编译引用**，
         否则 Kards.Ui.dll 的 AssemblyRef 会出现 Orc.Client／Orc.Protocol，
         被 UI_BOUNDARY_VERIFY_OK 判为越界（UI 只许经本桥接层的公开面说话）。 -->
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Client/Orc.Client.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(OrcEngineRoot)/../Orc.Manager/Orc.Manager.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Manager is an executable assembly; explicit runtime reference keeps it in Godot's deps manifest. -->
    <Reference Include="Orc.Manager">
      <HintPath>$(OrcEngineRoot)/../Orc.Manager/bin/$(Configuration)/net8.0/Orc.Manager.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
  </ItemGroup>
</Project>
