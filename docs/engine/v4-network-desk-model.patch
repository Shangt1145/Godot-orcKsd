+    private const int ModelChunkBytes = 512 * 1024;
+    private const int MaxModelBytes = 20 * 1024 * 1024;
+
+    private static bool ValidModelHash(string hash, bool allowEmpty = false) =>
+        (allowEmpty && hash.Length == 0) || (hash.Length == 64 && hash.All(c => char.IsAsciiHexDigit(c) && !char.IsLower(c)));
+
+    private static void ClearModelUpload(CosmeticSeat seat)
+    {
+        seat.Upload = null;
+        seat.UploadHash = "";
+        seat.Uploaded = 0;
+    }
+
+    private static RpcResponse UploadCosmeticModel(RpcRequest request, JsonObject args, CosmeticSeat own)
+    {
+        var hash = args["hash"]!.GetValue<string>();
+        var total = args["total"]!.GetValue<int>();
+        var offset = args["offset"]!.GetValue<int>();
+        var encoded = args["data"]!.GetValue<string>();
+        if (!ValidModelHash(hash) || total is < 20 or > MaxModelBytes || offset < 0 || offset >= total ||
+            encoded.Length > ((ModelChunkBytes + 2) / 3) * 4)
+            throw new ArgumentException("桌饰模型分片无效。");
+        var bytes = Convert.FromBase64String(encoded);
+        if (bytes.Length != Math.Min(ModelChunkBytes, total - offset))
+            throw new ArgumentException("桌饰模型分片大小无效。");
+        if (hash == own.ModelHash)
+            return RpcResponse.Success(request.Id, new JsonObject { ["hash"] = hash, ["complete"] = true });
+        if (offset == 0)
+        {
+            own.Upload = new byte[total];
+            own.UploadHash = hash;
+            own.Uploaded = 0;
+        }
+        if (own.Upload is not { } upload || own.UploadHash != hash || upload.Length != total || own.Uploaded != offset)
+            throw new ArgumentException("桌饰模型分片顺序无效。");
+        bytes.CopyTo(upload, offset);
+        own.Uploaded += bytes.Length;
+        var complete = own.Uploaded == total;
+        if (complete)
+        {
+            try
+            {
+                if (Convert.ToHexString(SHA256.HashData(upload)) != hash)
+                    throw new ArgumentException("桌饰模型校验失败。");
+                CheckStaticModel(upload);
+            }
+            catch { ClearModelUpload(own); throw; }
+        }
+        return RpcResponse.Success(request.Id, new JsonObject { ["hash"] = hash, ["complete"] = complete });
+    }
+
+    private static void CheckStaticModel(byte[] model)
+    {
+        var jsonLength = BinaryPrimitives.ReadInt32LittleEndian(model.AsSpan(12, 4));
+        if (!model.AsSpan(0, 4).SequenceEqual("glTF"u8) ||
+            BinaryPrimitives.ReadInt32LittleEndian(model.AsSpan(4, 4)) != 2 ||
+            BinaryPrimitives.ReadInt32LittleEndian(model.AsSpan(8, 4)) != model.Length ||
+            !model.AsSpan(16, 4).SequenceEqual("JSON"u8) || jsonLength <= 0 || jsonLength > model.Length - 20)
+            throw new ArgumentException("需要有效的 GLB 2.0 桌饰。");
+        using var doc = JsonDocument.Parse(model.AsMemory(20, jsonLength));
+        if (doc.RootElement.TryGetProperty("animations", out var animations) && animations.GetArrayLength() != 0)
+            throw new ArgumentException("联机桌饰不能携带动画。");
+        foreach (var key in new[] { "buffers", "images" })
+            if (doc.RootElement.TryGetProperty(key, out var entries))
+                foreach (var entry in entries.EnumerateArray())
+                    if (entry.TryGetProperty("uri", out var uri) && !(uri.GetString() ?? "").StartsWith("data:", StringComparison.Ordinal))
+                        throw new ArgumentException("联机桌饰不能引用外部资源。");
+    }
+
+    private RpcResponse ReadCosmeticModel(RpcRequest request, JsonObject args)
+    {
+        var seat = args["seat"]!.GetValue<int>();
+        var hash = args["hash"]!.GetValue<string>();
+        var offset = args["offset"]!.GetValue<int>();
+        if (!_cosmeticSeats.TryGetValue(seat, out var owner) || owner.ModelHash != hash ||
+            owner.Model is not { } bytes || offset < 0 || offset >= bytes.Length)
+            throw new ArgumentException("桌饰模型不存在。");
+        return RpcResponse.Success(request.Id, new JsonObject
+        {
+            ["total"] = bytes.Length,
+            ["data"] = Convert.ToBase64String(bytes, offset, Math.Min(ModelChunkBytes, bytes.Length - offset))
+        });
+    }
+
     private static IEnumerable<string> ProfileImages(JsonObject profile) => new[]{"CardBack","Decoration","Headquarters"}
