+    /// <summary>
+    /// 广播"对局已开始"。收件人筛选与 <see cref="PushViewsAsync"/> 一致（绑座 viewer ＋ 全知），
+    /// 但**先于第一帧视图**发出：客户端靠它切战场，才不会错过换牌相位。
+    /// </summary>
+    internal void NotifyMatchStarted(string roomId)
+    {
+        var payload = new JsonObject { ["roomId"] = roomId };
+        foreach (var session in _sessions.Values)
+        {
+            // 按"谁在对局里"筛，不按 IsViewer 筛：纯 controller 角色（无 viewer）同样是玩家。
+            var receives = session.State is SessionState.Admitted or SessionState.Viewer or SessionState.Omniscient;
+            if (!receives) continue;
+            SendNotification(session, ProtocolMethods.NotifyMatchStarted, payload.DeepClone());
+        }
+    }
