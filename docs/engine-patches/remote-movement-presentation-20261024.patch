+    private JsonNode PresentationSegment(Orc.Output.EventSegment segment, Orc.Game.Match match, int? seat)
+    {
+        var visibility = seat is null ? null : new Orc.Game.Ui.MatchEventVisibility(match);
+        var viewer = match.Players[seat ?? 0];
+        var node = JsonNode.Parse(Orc.Output.EventSegmentJson.Serialize(segment, false, visibility, seat is null ? null : viewer))!;
+        var entries = node["entries"]!.AsArray();
+        var provider = match.UiProjections.CreateProvider(null, Service.Options.MatchId, null);
+        for (var i = 0; i < segment.Entries.Count; i++)
+        {
+            var entry = segment.Entries[i];
+            // Player identity is public even when draw-card identities are redacted.
+            if (entry.Data.GetValueOrDefault("Player") is Orc.Game.Players.Player player)
+                entries[i]!["playerSeat"] = player.Index;
+            // A played order has left the projected board. Supply only this public face;
+            // never project arbitrary event cards (opponent draws/hand remain hidden).
+            if (entry.Message == "card.played" && entry.Data.GetValueOrDefault("Card") is Orc.Game.Cards.OrderCard order
+                && visibility?.IsEntityVisible(order, viewer) != false && provider is not null)
+            {
+                entries[i]!["cardView"] = JsonSerializer.SerializeToNode(provider.ReadCard(match, order, viewer, "hand", 0), ProtocolJson.Options);
+                entries[i]!["ownerSeat"] = order.Owner?.Index;
+            }
+        }
+        return node;
+    }
+
