diff --git a/src/Orc.Game/Cards/SmokeScreenRules.cs b/src/Orc.Game/Cards/SmokeScreenRules.cs
new file mode 100644
--- /dev/null
+++ b/src/Orc.Game/Cards/SmokeScreenRules.cs
@@ -0,0 +1,24 @@
+using Orc.Cards;
+
+namespace Orc.Game.Cards;
+
+/// <summary>Smoke protects support units until they advance or attack; it is not covert.</summary>
+public static class SmokeScreenRules
+{
+    internal static bool CanGrant(Card card, KeywordLoadContext? context) =>
+        !card.TryGetData<UnitStateData>(out var state) || state.Line is null
+        || context?.Battlefield is not { } battlefield || !ReferenceEquals(state.Line, battlefield.FrontLine);
+
+    internal static Task RemoveOnFrontAsync(UnitCard unit, CancellationToken ct = default) =>
+        CanGrant(unit, unit.Keywords.LoadContextProvider?.Invoke()) ? Task.CompletedTask : RemoveAsync(unit, ct);
+
+    /// <summary>Drop the runtime keyword and publish its change for local and remote projections.</summary>
+    public static async Task RemoveAsync(UnitCard unit, CancellationToken ct = default)
+    {
+        if (!unit.TryGetData<UnitStateData>(out var state) || state.IsDestroyed
+            || !unit.Keywords.Has(KeywordIds.SmokeScreen)) return;
+        if (await unit.Keywords.RevokeAsync(KeywordIds.SmokeScreen).ConfigureAwait(false)
+            && unit.Keywords.LoadContextProvider?.Invoke() is { } context)
+            await GameUpdates.EmitCardStatChanged(context.Engine, unit, ["keywords"], ct).ConfigureAwait(false);
+    }
+}
diff --git a/tests/Orc.Game.Tests/SmokeScreenLifecycleTests.cs b/tests/Orc.Game.Tests/SmokeScreenLifecycleTests.cs
new file mode 100644
--- /dev/null
+++ b/tests/Orc.Game.Tests/SmokeScreenLifecycleTests.cs
@@ -0,0 +1,58 @@
+using Orc.Game.Cards;
+using Orc.Game.Commanding;
+using Xunit;
+
+namespace Orc.Game.Tests;
+
+public class SmokeScreenLifecycleTests
+{
+    [Fact]
+    public async Task MovingToFrontRemovesSmokeAndRetreatDoesNotRestoreIt()
+    {
+        var bridge = new MockTargeterBridge();
+        var match = CommandTestKit.CreateCommandMatch(bridge);
+        await match.Initialize();
+        var unit = await CommandTestKit.PrepareOnSupportAsync(match, match.Players[0], CommandTestKit.SmokeId, 1);
+        CommandTestKit.Activate(unit);
+        bridge.CollectScript = CommandTestKit.AllRefsScript(match);
+        Assert.True(unit.Keywords.Has(KeywordIds.SmokeScreen));
+        var result = await CommandTestKit.RunCommandAsync(match, bridge, unit, match.Battlefield.FrontLine.GetInsertionGaps()[0].Ref);
+        Assert.Equal(CommandResultStatus.Success, result.Status);
+        Assert.False(unit.Keywords.Has(KeywordIds.SmokeScreen));
+        Assert.False(await unit.Keywords.GrantAsync(KeywordIds.SmokeScreen));
+        var runtime = Orc.Game.Effects.EffectRuntime.ResolveFor(unit)!;
+        Assert.True(await runtime.MoveAsync(unit, "support"));
+        Assert.False(unit.Keywords.Has(KeywordIds.SmokeScreen));
+    }
+
+    [Fact]
+    public async Task DirectFrontPlacementCannotKeepOrGainSmoke()
+    {
+        var match = CommandTestKit.CreateCommandMatch();
+        await match.Initialize();
+        var unit = await CommandTestKit.PrepareOnFrontAsync(match, match.Players[0], CommandTestKit.SmokeId, 0);
+        Assert.False(unit.Keywords.Has(KeywordIds.SmokeScreen));
+        Assert.False(await unit.Keywords.GrantAsync(KeywordIds.SmokeScreen));
+        while (!ReferenceEquals(match.CurrentPlayer, match.Players[1])) await match.EndTurn();
+        var attacker = await CommandTestKit.PrepareOnSupportAsync(match, match.Players[1], CommandTestKit.ArtilleryId, 1);
+        CommandTestKit.Activate(attacker);
+        Assert.Contains(unit.Ref, match.CommandManager.GetCommandAvailability(attacker).Attack.Candidates);
+    }
+
+    [Fact]
+    public async Task AttackingFromSupportRemovesSmokeButCancellationKeepsIt()
+    {
+        var bridge = new MockTargeterBridge();
+        var match = CommandTestKit.CreateCommandMatch(bridge);
+        await match.Initialize();
+        var unit = await CommandTestKit.PrepareOnSupportAsync(match, match.Players[0], CommandTestKit.SmokeId, 1);
+        var enemy = await CommandTestKit.PrepareOnFrontAsync(match, match.Players[1], CommandTestKit.InfantryId, 0);
+        CommandTestKit.Activate(unit);
+        bridge.CollectScript = CommandTestKit.AllRefsScript(match);
+        await CommandTestKit.CancelCommandAsync(match, bridge, unit);
+        Assert.True(unit.Keywords.Has(KeywordIds.SmokeScreen));
+        var result = await CommandTestKit.RunCommandAsync(match, bridge, unit, enemy.Ref);
+        Assert.Equal(CommandResultStatus.Success, result.Status);
+        Assert.False(unit.Keywords.Has(KeywordIds.SmokeScreen));
+    }
+}
