diff --git a/src/Orc.Protocol/NetworkPackageArchive.cs b/src/Orc.Protocol/NetworkPackageArchive.cs
new file mode 100644
index 0000000..4faef0a
--- /dev/null
+++ b/src/Orc.Protocol/NetworkPackageArchive.cs
@@ -0,0 +1,104 @@
+using System.IO.Compression;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json.Nodes;
+
+namespace Orc.Protocol;
+
+/// <summary>Bounded card-pack transport. Receiving bytes never installs or executes a package.</summary>
+public static class NetworkPackageArchive
+{
+    public const long MaxBytes = 256L * 1024 * 1024;
+    public const int ChunkBytes = 256 * 1024;
+    public static string Hash(byte[] bytes) => Convert.ToHexString(SHA256.HashData(bytes));
+    public static string Key(string value) => Hash(Encoding.UTF8.GetBytes(value));
+    public static string Child(string root, string relative)
+    {
+        var parts = relative.Replace('\\', '/').Split('/');
+        if (parts.Any(p => p.Length == 0 || p is "." or ".." || p.EndsWith(' ') || p.EndsWith('.')
+            || p.Any(c => c < 32 || "<>:\"|?*".Contains(c))
+            || new[] { "CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9" }.Contains(p.Split('.')[0], StringComparer.OrdinalIgnoreCase)))
+            throw new InvalidDataException("卡包包含非法路径：" + relative);
+        var path = Path.GetFullPath(Path.Combine(root, Path.Combine(parts)));
+        if (!path.StartsWith(Path.GetFullPath(root) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException("卡包路径越界。");
+        return path;
+    }
+    public static IEnumerable<string> Files(string root)
+    {
+        foreach (var entry in Directory.EnumerateFileSystemEntries(root).OrderBy(p => p, StringComparer.Ordinal))
+        {
+            var attributes = File.GetAttributes(entry);
+            if ((attributes & FileAttributes.ReparsePoint) != 0) throw new InvalidDataException("卡包不能包含链接。");
+            if ((attributes & FileAttributes.Directory) != 0)
+            { foreach (var file in Files(entry)) yield return file; }
+            else yield return entry;
+        }
+    }
+    public static string Digest(string root)
+    {
+        using var hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+        long total = 0; int count = 0;
+        foreach (var file in Files(root))
+        {
+            if (++count > 8192 || (total += new FileInfo(file).Length) > MaxBytes) throw new InvalidDataException("卡包超过传输大小限制。");
+            hash.AppendData(Encoding.UTF8.GetBytes(Path.GetRelativePath(root, file).Replace('\\', '/')));
+            hash.AppendData([0]); hash.AppendData(File.ReadAllBytes(file)); hash.AppendData([0]);
+        }
+        return Convert.ToHexString(hash.GetHashAndReset());
+    }
+    public static byte[] Zip(string root)
+    {
+        _ = Digest(root);
+        using var stream = new MemoryStream();
+        using (var zip = new ZipArchive(stream, ZipArchiveMode.Create, true))
+            foreach (var file in Files(root))
+            {
+                var entry = zip.CreateEntry(Path.GetRelativePath(root, file).Replace('\\', '/'), CompressionLevel.Fastest);
+                entry.LastWriteTime = new DateTimeOffset(2000, 1, 1, 0, 0, 0, TimeSpan.Zero);
+                using var output = entry.Open(); using var input = File.OpenRead(file); input.CopyTo(output);
+            }
+        if (stream.Length > MaxBytes) throw new InvalidDataException("卡包压缩文件过大。");
+        return stream.ToArray();
+    }
+    public static void Extract(byte[] bytes, string root)
+    {
+        if (bytes.LongLength > MaxBytes) throw new InvalidDataException("卡包压缩文件过大。");
+        using var zip = new ZipArchive(new MemoryStream(bytes), ZipArchiveMode.Read);
+        if (zip.Entries.Count > 8192) throw new InvalidDataException("卡包文件过多。");
+        long total = 0; var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        Directory.CreateDirectory(root);
+        foreach (var entry in zip.Entries)
+        {
+            var path = Child(root, entry.FullName);
+            var type = (entry.ExternalAttributes >> 16) & 0xF000;
+            if (!seen.Add(path) || type is not 0 and not 0x8000 || (entry.ExternalAttributes & (int)FileAttributes.ReparsePoint) != 0)
+                throw new InvalidDataException("卡包包含重复路径或链接。");
+            total = checked(total + entry.Length);
+            if (total > MaxBytes) throw new InvalidDataException("卡包解压后过大。");
+            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+            using var input = entry.Open(); using var output = File.Create(path);
+            var buffer = new byte[81920]; long written = 0; int read;
+            while ((read = input.Read(buffer, 0, buffer.Length)) > 0)
+            {
+                if ((written += read) > entry.Length) throw new InvalidDataException("卡包文件大小异常。");
+                output.Write(buffer, 0, read);
+            }
+            if (written != entry.Length) throw new InvalidDataException("卡包文件不完整。");
+        }
+        if (!File.Exists(Path.Combine(root, "manifest.json"))) throw new InvalidDataException("卡包缺少 manifest.json。");
+    }
+    public static JsonObject Describe(string root)
+    {
+        var manifest = JsonNode.Parse(File.ReadAllText(Path.Combine(root, "manifest.json")))!;
+        if (manifest["kind"]?.ToString() != "cardpack") throw new InvalidDataException("联机只能传输 cardpack 卡包。");
+        var bytes = Zip(root);
+        var name = manifest["name"]?.ToString() ?? manifest["id"]!.ToString();
+        if (name.Length > 160) name = name[..160];
+        return new JsonObject { ["id"] = manifest["id"]!.ToString(), ["name"] = name,
+            ["version"] = manifest["version"]!.ToString(), ["guid"] = manifest["guid"]!.ToString(),
+            ["digest"] = Digest(root), ["bytes"] = bytes.Length, ["sha256"] = Hash(bytes) };
+    }
+    public static string Fingerprint(IEnumerable<JsonObject> packages) => Key(string.Join("\n", packages.OrderBy(p => p["id"]!.ToString(), StringComparer.Ordinal)
+        .Select(p => p["id"] + ":" + p["digest"])));
+}
diff --git a/src/Orc.Server/Transport/ServerHost.NetworkVocabulary.cs b/src/Orc.Server/Transport/ServerHost.NetworkVocabulary.cs
new file mode 100644
index 0000000..55c0452
--- /dev/null
+++ b/src/Orc.Server/Transport/ServerHost.NetworkVocabulary.cs
@@ -0,0 +1,50 @@
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Orc.Cards;
+using Orc.Game.Cards;
+using Orc.Packages;
+
+namespace Orc.Server.Transport;
+
+public sealed partial class ServerHost
+{
+    private static readonly Dictionary<string, string> NetworkKeywords = new(StringComparer.Ordinal);
+    internal static void RegisterNetworkVocabulary(string root)
+    {
+        var presentation = Path.Combine(root, "workshop.presentation.json");
+        if (File.Exists(presentation))
+            foreach (var n in JsonNode.Parse(File.ReadAllText(presentation))?["nations"] as JsonArray ?? new())
+                if (n?["id"]?.GetValue<string>() is { Length: > 0 } id) Faction.RegisterCustom(id);
+        // Built-in legacy nations are also used by the compatibility editor.
+        foreach (var id in new[] { "av76", "deran", "usg", "un" }) Faction.RegisterCustom(id);
+        var declarations = PackageScanner.ReadKeywords(root);
+        var runtime = Path.Combine(root, "network-vocabulary.json");
+        var legacy = File.Exists(runtime) ? JsonNode.Parse(File.ReadAllText(runtime))!.AsArray() : new JsonArray();
+        lock (NetworkKeywords)
+        {
+            foreach (var keyword in declarations)
+            {
+                var signature = JsonSerializer.Serialize(keyword);
+                if (NetworkKeywords.TryGetValue(keyword.Id, out var existing))
+                { if (existing != signature) throw new InvalidDataException("卡包词条冲突：" + keyword.Id); continue; }
+                if (KeywordRegistry.IsDefined(keyword.Id)) throw new InvalidDataException("卡包词条与既有词条重名：" + keyword.Id);
+                if (keyword.Program is { } program) ProgramKeywordComponent.Register(keyword.Id, KeywordProgram.Parse(program), keyword.IsBattleKeyword);
+                else KeywordRegistry.RegisterOrReplace(keyword.Id, (_, value) => new PlainKeywordComponent(keyword.Id, value), keyword.IsBattleKeyword);
+                if (keyword.Bindings.Count > 0) KeywordRegistry.DeclareEffectBindings(keyword.Id, keyword.Bindings);
+                NetworkKeywords.Add(keyword.Id, signature);
+            }
+            foreach (var node in legacy.OfType<JsonObject>())
+            {
+                var id = node["id"]!.ToString(); var signature = node.ToJsonString();
+                if (!id.StartsWith("kw-", StringComparison.Ordinal)) throw new InvalidDataException("工坊词条标识无效。");
+                if (NetworkKeywords.TryGetValue(id, out var existing))
+                { if (signature != existing) throw new InvalidDataException("工坊词条内容冲突：" + id); continue; }
+                if (KeywordRegistry.IsDefined(id)) throw new InvalidDataException("工坊词条与既有词条重名：" + id);
+                var battle = node["battle"]?.GetValue<bool>() == true;
+                if (node["program"] is { } program) ProgramKeywordComponent.Register(id, KeywordProgram.Parse(program.ToJsonString()), battle);
+                else DeclarativeKeywordComponent.Register(id, node["snapshots"]!.AsArray().Select(s => PrefabJson.Deserialize(s!.ToJsonString())).ToArray(), battle);
+                NetworkKeywords.Add(id, signature);
+            }
+        }
+    }
+}
diff --git a/src/Orc.Server/Transport/ServerHost.PackTransfer.cs b/src/Orc.Server/Transport/ServerHost.PackTransfer.cs
new file mode 100644
index 0000000..0372cdc
--- /dev/null
+++ b/src/Orc.Server/Transport/ServerHost.PackTransfer.cs
@@ -0,0 +1,159 @@
+using System.Text.Json.Nodes;
+using Orc.Mcp.Pool;
+using Orc.Protocol;
+using Orc.Server.Admin;
+using Orc.Server.Execution;
+using Orc.Server.Rooms;
+
+namespace Orc.Server.Transport;
+
+public sealed partial class ServerHost
+{
+    private bool _allowGuestPacks, _requirePackAlignment;
+    private string _transferRoom = "";
+    private readonly Dictionary<string, (string Root, JsonObject Info, byte[] Zip)> _transferPacks = new(StringComparer.Ordinal);
+    private readonly Dictionary<string, (string Room, string Fingerprint)> _packAcks = new();
+    private readonly Dictionary<string, (JsonObject Info, MemoryStream Bytes)> _packUploads = new();
+    private readonly HashSet<string> _receivedPackRoots = new(StringComparer.OrdinalIgnoreCase);
+
+    private void ResetPackTransfers()
+    {
+        Packs.RemoveSessionDirectories(_receivedPackRoots);
+        _receivedPackRoots.Clear(); _transferPacks.Clear(); _packAcks.Clear();
+        foreach (var upload in _packUploads.Values) upload.Bytes.Dispose(); _packUploads.Clear();
+        _allowGuestPacks = false;
+    }
+
+    // Called exclusively through the parent's private admin channel.
+    public Task<AdminOutcome> SetPackTransferPolicyAsync(bool allowGuests, bool requireAlignment, CancellationToken ct)
+        => _queue.EnqueueAsync(WorkPriority.Command, _ =>
+        {
+            if (Room.State != RoomState.Lobby) return Task.FromResult(AdminOutcome.Fail("room-started", "只能在大厅更改卡包接收设置。"));
+            _allowGuestPacks = allowGuests; _requirePackAlignment = requireAlignment;
+            if (!allowGuests) { foreach (var upload in _packUploads.Values) upload.Bytes.Dispose(); _packUploads.Clear(); }
+            return Task.FromResult(AdminOutcome.Success(new JsonObject { ["allowGuestPacks"] = allowGuests }));
+        }, ct);
+
+    private void RefreshTransferCatalog()
+    {
+        if (_transferRoom != Room.RoomId)
+        {
+            _transferRoom = Room.RoomId; _packAcks.Clear();
+            foreach (var upload in _packUploads.Values) upload.Bytes.Dispose(); _packUploads.Clear();
+        }
+        foreach (var owner in _packUploads.Keys.Where(owner => !_sessions.Values.Any(s => s.State == SessionState.Admitted && s.IsController && s.SeatToken == owner)).ToArray())
+        { _packUploads[owner].Bytes.Dispose(); _packUploads.Remove(owner); }
+        foreach (var root in Packs.PrepareAssembly().Directories)
+        {
+            var manifest = JsonNode.Parse(File.ReadAllText(Path.Combine(root, "manifest.json")))!;
+            var id = manifest["id"]!.ToString();
+            if (_transferPacks.ContainsKey(id)) continue; // Inputs are frozen session copies.
+            var info = NetworkPackageArchive.Describe(root);
+            _transferPacks.Add(id, (root, info, NetworkPackageArchive.Zip(root)));
+        }
+    }
+    private string TransferFingerprint => NetworkPackageArchive.Fingerprint(_transferPacks.Values.Select(p => p.Info));
+    public string? PackAlignmentFailure()
+    {
+        if (!_requirePackAlignment) return null;
+        RefreshTransferCatalog();
+        var fingerprint = TransferFingerprint;
+        foreach (var s in _sessions.Values.Where(s => s.State == SessionState.Admitted && s.IsController && s.Seat is not null))
+            if (s.SeatToken is null || !_packAcks.TryGetValue(s.SeatToken, out var ack) || ack.Room != Room.RoomId || ack.Fingerprint != fingerprint)
+                return $"座位 {s.Seat + 1} 的卡包尚未同步完成，请等待双方卡池已对齐后开局。";
+        if (_packUploads.Count > 0) return "仍有卡包正在上传，请等待同步完成。";
+        return null;
+    }
+    private async Task<RpcResponse> HandlePackTransferAsync(RpcRequest request, ClientSession session, CancellationToken ct)
+    {
+        if (!CosmeticReader(session)) return RpcResponse.Failure(request.Id, RpcErrorCodes.InvalidRequest, "卡包同步需要已批准的房间会话。");
+        try
+        {
+            return await _queue.EnqueueAsync(WorkPriority.Command, async token =>
+            {
+                if (IsDraining) throw new InvalidOperationException("房间正在轮换，请重试。");
+                RefreshTransferCatalog();
+                var args = request.Params as JsonObject ?? new JsonObject();
+                if (request.Method == "pool.manifest")
+                {
+                    return RpcResponse.Success(request.Id, new JsonObject { ["roomId"] = Room.RoomId,
+                        ["lobby"] = Room.State == RoomState.Lobby, ["fingerprint"] = TransferFingerprint,
+                        ["allowGuestPacks"] = _allowGuestPacks, ["aligned"] = PackAlignmentFailure() is null,
+                        ["packages"] = new JsonArray(_transferPacks.Values.Select(p => (JsonNode)p.Info.DeepClone()).ToArray()) });
+                }
+                if (request.Method == "pool.fetch")
+                {
+                    if (!_transferPacks.TryGetValue(args["id"]!.ToString(), out var pack)) throw new InvalidDataException("卡包不存在。");
+                    if (args["digest"]!.ToString() != pack.Info["digest"]!.ToString()) throw new InvalidDataException("卡包代次已经变化，请重新同步。");
+                    var offset = args["offset"]!.GetValue<int>();
+                    if (offset < 0 || offset >= pack.Zip.Length) throw new InvalidDataException("卡包分块偏移无效。");
+                    var block = pack.Zip.AsSpan(offset, Math.Min(NetworkPackageArchive.ChunkBytes, pack.Zip.Length - offset)).ToArray();
+                    return RpcResponse.Success(request.Id, new JsonObject { ["data"] = Convert.ToBase64String(block), ["sha256"] = NetworkPackageArchive.Hash(block) });
+                }
+                if (Room.State != RoomState.Lobby) throw new InvalidOperationException("对局开始后不能更改卡包。");
+                if (!session.IsController || session.SeatToken is not { } seatToken) throw new InvalidOperationException("只有已批准的玩家可以提交卡包或确认卡池。");
+                if (request.Method == "pool.ack")
+                {
+                    if (args["fingerprint"]!.ToString() != TransferFingerprint) throw new InvalidDataException("卡池已变化，请重新同步。");
+                    _packAcks[seatToken] = (Room.RoomId, TransferFingerprint);
+                    return RpcResponse.Success(request.Id, new JsonObject { ["ok"] = true });
+                }
+                if (!_allowGuestPacks) throw new InvalidOperationException("房主尚未开启接收好友卡包，请房主开启后重新同步。");
+                if (request.Method == "pool.offer")
+                {
+                    var info = (args["package"] as JsonObject)?.DeepClone().AsObject() ?? throw new InvalidDataException("卡包声明为空。");
+                    var id = info["id"]!.ToString(); var size = info["bytes"]!.GetValue<long>();
+                    if (id.Length is < 1 or > 160 || size is < 1 or > NetworkPackageArchive.MaxBytes || info["digest"]!.ToString().Length != 64)
+                        throw new InvalidDataException("卡包声明不合法。");
+                    if (_transferPacks.TryGetValue(id, out var existing))
+                    {
+                        if (existing.Info["digest"]!.ToString() != info["digest"]!.ToString()) throw new InvalidDataException("同名卡包内容不一致：" + id + "。请双方统一版本。");
+                        return RpcResponse.Success(request.Id, new JsonObject { ["exists"] = true });
+                    }
+                    if (_transferPacks.Count >= 128 || _transferPacks.Values.Sum(p => p.Zip.LongLength) + size > 512L * 1024 * 1024)
+                        throw new InvalidDataException("房间卡包缓存已满。");
+                    if (_packUploads.Remove(seatToken, out var previous)) previous.Bytes.Dispose();
+                    _packUploads[seatToken] = (info, new MemoryStream());
+                    return RpcResponse.Success(request.Id, new JsonObject { ["offset"] = 0 });
+                }
+                if (!_packUploads.TryGetValue(seatToken, out var upload)) throw new InvalidDataException("请先声明要上传的卡包。");
+                if (request.Method == "pool.chunk")
+                {
+                    var encoded = args["data"]!.ToString();
+                    if (encoded.Length > 350000) throw new InvalidDataException("分块过大。");
+                    var block = Convert.FromBase64String(encoded);
+                    if (block.Length == 0 || block.Length > NetworkPackageArchive.ChunkBytes || NetworkPackageArchive.Hash(block) != args["sha256"]!.ToString()
+                        || upload.Bytes.Length != args["offset"]!.GetValue<long>() || upload.Bytes.Length + block.Length > upload.Info["bytes"]!.GetValue<long>())
+                        throw new InvalidDataException("分块大小、顺序或校验和不正确。");
+                    upload.Bytes.Write(block);
+                    return RpcResponse.Success(request.Id, new JsonObject { ["offset"] = upload.Bytes.Length });
+                }
+                if (request.Method != "pool.commit") throw new InvalidDataException("未知卡包同步操作。");
+                var bytes = upload.Bytes.ToArray();
+                if (bytes.LongLength != upload.Info["bytes"]!.GetValue<long>() || NetworkPackageArchive.Hash(bytes) != upload.Info["sha256"]!.ToString())
+                    throw new InvalidDataException("卡包尚未传完或校验失败。");
+                var parent = Path.Combine(_options.SandboxRoot, "net-assets", Room.RoomId);
+                var root = Path.Combine(parent, Guid.NewGuid().ToString("N"));
+                Directory.CreateDirectory(parent);
+                try
+                {
+                    NetworkPackageArchive.Extract(bytes, root);
+                    var actual = NetworkPackageArchive.Describe(root);
+                    foreach (var key in new[] { "id", "version", "guid", "digest" })
+                        if (actual[key]!.ToString() != upload.Info[key]!.ToString()) throw new InvalidDataException("卡包身份或内容校验失败：" + key);
+                    actual["bytes"] = bytes.Length; actual["sha256"] = NetworkPackageArchive.Hash(bytes);
+                    RegisterNetworkVocabulary(root);
+                    var registered = await Packs.RegisterAsync(root, PoolAudience.RemotePlay, token).ConfigureAwait(false);
+                    if (!registered.Ok) throw new InvalidDataException(registered.Message ?? registered.Code);
+                    _transferPacks.Add(actual["id"]!.ToString(), (root, actual, bytes));
+                    _receivedPackRoots.Add(Path.GetFullPath(root));
+                }
+                catch { if (Directory.Exists(root)) Directory.Delete(root, true); throw; }
+                finally { upload.Bytes.Dispose(); _packUploads.Remove(seatToken); }
+                return RpcResponse.Success(request.Id, new JsonObject { ["ok"] = true });
+            }, ct).ConfigureAwait(false);
+        }
+        catch (Exception e) when (e is not OperationCanceledException)
+        { return RpcResponse.Failure(request.Id, RpcErrorCodes.InvalidParams, e.Message); }
+    }
+}
