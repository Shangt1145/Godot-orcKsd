+    public static Card[] RecallTargets(Card source, string declaration) => AuthoringTargetContext.Recall(source, declaration);
+    public static async Task AttributeAsync(Card target, string property, string mode, int value, string duration, CancellationToken ct)
+    {
+        var field = property switch { "attack" => CardStatFields.Attack, "defense" when target is Hq => CardStatFields.HqHealth,
+            "defense" => CardStatFields.Defense, "opCost" => CardStatFields.OperateCost, "cost" => CardStatFields.DeployCost,
+            _ => throw new InvalidDataException("尚未接入属性：" + property) };
