+    }
+    public static async Task DiscardAsync(Card source, Card target, CancellationToken ct)
+    {
+        if (target is not CardBase c || c.Owner is not { } owner || !owner.Hand.Contains(c)) return;
+        owner.Hand.Remove(c); await source.Engine.DestroyCard(c);
+        await GameUpdates.EmitCardDiscarded(source.Engine, c, owner, ct, source: source);
+    }
+    public static async Task<Card[]> ChooseAsync(Card source, Card[] candidates, int count, CancellationToken ct)
+    {
+        if(count<1||count>candidates.Length)return [];
+        Card[] chosen=[];
+        var outcome=await Match(source).TargeterManager.RunAsync(async flow=> {
+            var step=await flow.Step(SelectorTemplates.CardPickerSet,new ReferenceSetParameter(candidates.Select(c=>c.Ref),count,count,
