+        if(Text(target,"side") is not ("" or "any" or "friendly" or "enemy" or "both"))throw new InvalidDataException("选靶阵营无效");
+    }
+    /// <summary>Presentation metadata must not invent a deployment effect removed from native data.</summary>
+    public static bool HasInteractivePlayEffect(CardBase card,string trigger)
+    {
+        var hook=trigger=="deploy"?"unit.deployed":trigger is "play" or "order"?"card.played":null;
+        if(hook is null)return false;
+        return card.Effects.Any(effect=>effect is not DynamicPassiveEffect native || native.Snapshot.Root.MainTrigger.Hooks.Contains(hook));
+    }
+    public static string Scope(JsonElement graph)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(graph.GetRawText())))[..24];
+    public static async Task<Card[]> SelectAsync(Card source,string declaration,string scope,CancellationToken ct)
+    {
+        if(AuthoringRuntime.Owner(source) is null||!Owners.TryGetValue(AuthoringRuntime.Owner(source),out var context))throw new InvalidOperationException("原生声明选靶上下文未装配");
+        if(context._captured.TryGetValue(source,out var selection)&&selection.TryGetValue(scope+"|"+declaration,out var captured))
+        {if(context._consumed.TryGetValue(source,out var consumed))consumed.Add(scope+"|"+declaration);context.Remember(source,declaration,captured);return captured;}
+        return await context.SelectCore(source,declaration,ct);
+    }
+    /// <summary>同一张卡上「其」的回指：取该目标声明最近一次选中的结果（仍要求存活）。
+    /// 与 <see cref="SelectAsync"/> 的区别是它**不发起选靶**——跨效果的指代没有第二次询问的时机。</summary>
+    public static Card[] Recall(Card source,string declaration)
+    {
+        if(AuthoringRuntime.Owner(source) is null||!Owners.TryGetValue(AuthoringRuntime.Owner(source),out var context))return [];
+        if(!context._recent.TryGetValue(source,out var recent))return [];
+        var id=TargetId(declaration);
+        if(id.Length==0||!recent.TryGetValue(id,out var targets))return [];
+        return Array.FindAll(targets,c=>AuthoringRuntime.Flag(c,"alive"));
+    }
+    private static string TargetId(string declaration)
+    {
+        try
+        {
+            using var doc=JsonDocument.Parse(declaration);
+            return Text(doc.RootElement,"id");
+        }
+        catch(JsonException){return "";}
+    }
+    private void Remember(Card source,string declaration,Card[] targets)
+    {
+        var id=TargetId(declaration);
+        if(id.Length==0)return;
+        _recent.GetOrCreateValue(source)[id]=targets;
+    }
+    /// <summary>Older native snapshots request their own selector after desktop pre-play capture.
+    /// Re-submit that captured choice through the native selector once, preserving its validation
+    /// and targeted notifications instead of asking the player to choose a second time.</summary>
+    public bool TryReplayNativeSelection(ISelectorInstance selector)
+    {
+        var data=selector.Presentation;
+        if(data.Parameter is not Card source||data.Identifiers is not null||data.Min!=1||data.Max!=1
+            ||!_captured.TryGetValue(source,out var captured)||!_consumed.TryGetValue(source,out var consumed))return false;
+        foreach(var (key,targets) in captured)
+        {
+            if(consumed.Contains(key)||targets.Length!=1)continue;
+            var candidate=data.Candidates.FirstOrDefault(r=>r.IsAlive&&ReferenceEquals(r.Value,targets[0]));
+            if(candidate is null)continue;
+            consumed.Add(key);selector.Submit(new PickEvent([candidate]));return true;
+        }
+        return false;
+    }
+    private async Task<Card[]> SelectCore(Card source,string declaration,CancellationToken ct,bool includeSource=false)
+    {
+        using var doc=JsonDocument.Parse(declaration);var target=doc.RootElement;ValidateTarget(target);
+        var candidates=(await ResolveCandidates(source,target,ct,includeSource)).ToArray();
+        if(candidates.Length==0)return [];
+        Card? selected=null;
+        var result=await _match.TargeterManager.RunAsync(async flow=>
+        {
+            var references=candidates.Select(c=>c.Ref).ToArray();
+            var step=await flow.Step(SelectorTemplates.FieldUnit,new ReferenceSetParameter(references,1,1,
+                domainValidator:r=>r.Value is Card card&&candidates.Contains(card)&&AuthoringRuntime.Flag(card,"alive"),
+                tag:new AuthoringSelectorTag(Text(target,"id"))));
+            while(step.IsFailed&&step.Failure==SelectorFailureReason.InvalidSelection)step=await flow.Retry<Ref<Entity>>();
+            if(step.IsCancelled)return TargeterResult.Cancelled();
+            if(!step.IsOk)return TargeterResult.FromSelectorFailure(step.Failure);
+            selected=(Card)step.Value!.Value;return TargeterResult.Ok();
+        });
+        ct.ThrowIfCancellationRequested();
+        if(result.IsOk&&selected is not null)
+        {
+            await TargetingRules.NotifyAsync(_match.Engine,selected,source,TargetingRules.KindEffect,triggerCard:source,ct);
+            Remember(source,declaration,[selected]);return [selected];
+        }
+        // 选靶"成功提交但拿不到结果"必须留下判据：这是效果静默不生效的唯一线索。
+        Console.WriteLine($"[desktop-target] empty selection ok={result.IsOk} selected={(selected is null?"null":"set")} "
+            + $"candidates={candidates.Length} declaration={declaration}");
+        return [];
+    }
+    public static Task<IReadOnlyList<Card>> ResolveCandidates(Card source,JsonElement target,CancellationToken ct=default,bool includeSource=false)
+    {
+        var runtime=EffectRuntime.ResolveFor(source)??throw new InvalidOperationException("原生效果服务未装配");
+        var zone=Text(target,"zone");var side=Text(target,"side");
+        var kind=Text(target,"kind");
+        ct.ThrowIfCancellationRequested();
+        var units=kind=="hq"||zone=="hq"?Array.Empty<Card>():runtime.QueryTargetCandidates(source,new("all",side is "any" or ""?"both":side,zone is "frontline" or "support"?zone:null));
+        var hqs=kind=="unit"?Array.Empty<Card>():runtime.QueryTargetCandidates(source,new("all",side is "any" or ""?"both":side,"hq"));
+        IEnumerable<Card> matches=units.Concat(hqs)
+            .Where(c=>!target.TryGetProperty("filter",out var filter)||AuthoringRuntime.Matches(c,filter.GetRawText()));
+        // 部署指向：这张牌即将落位，但在预打出阶段场面里还查不到它。
+        // 「使 1 个友方单位…」在空场时连自己都选不到，候选为 0 就会把整次部署取消掉——
+        // 玩家看到的是"卡丢上去没反应"。按声明本身把来源单位算进候选。
+        if(includeSource&&source is UnitCard self&&kind!="hq"&&zone is not "hq"&&side!="enemy")
+            matches=matches.Prepend(self);
+        return Task.FromResult<IReadOnlyList<Card>>(matches.ToArray());
+    }
+    private static string Text(JsonElement e,string key)=>e.TryGetProperty(key,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()!:"";
+    public void Dispose(){foreach(var r in _registrations)r.Trigger.Unregister(r.Handle);foreach(var p in _match.Players)Owners.Remove(p);}
+}
