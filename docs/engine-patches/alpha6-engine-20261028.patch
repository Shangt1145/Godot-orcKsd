+using System.IO.Compression;
+using System.Text.Json.Nodes;
+using Orc.Protocol;
+using Orc.Server.Admin;
+using Xunit;
+
+namespace Orc.Server.Tests;
+
+public sealed class NetworkPackageTransferTests
+{
+    [Theory]
+    [InlineData("../escape.json")] [InlineData("/absolute.json")] [InlineData("cards/CON.png")]
+    [InlineData("cards/A.json:stream")] [InlineData("cards/../escape.json")]
+    public void ExtractionRejectsUnsafePaths(string path)
+    {
+        var root = Path.Combine(Path.GetTempPath(), "orc-net-archive-" + Guid.NewGuid().ToString("N"));
+        using var memory = new MemoryStream();
+        using (var zip = new ZipArchive(memory, ZipArchiveMode.Create, true))
+        { using var writer = new StreamWriter(zip.CreateEntry(path).Open()); writer.Write("{}"); }
+        try { Assert.Throws<InvalidDataException>(() => NetworkPackageArchive.Extract(memory.ToArray(), root)); }
+        finally { if (Directory.Exists(root)) Directory.Delete(root, true); }
+    }
+    [Fact]
+    public void ExtractionRejectsCaseConflictsAndLinks()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "orc-net-archive-" + Guid.NewGuid().ToString("N"));
+        try
+        {
+            foreach (var link in new[] { false, true })
+            {
+                using var memory = new MemoryStream();
+                using (var zip = new ZipArchive(memory, ZipArchiveMode.Create, true))
+                {
+                    var entry = zip.CreateEntry("file.json"); if (link) entry.ExternalAttributes = unchecked((int)0xA0000000);
+                    using (var writer = new StreamWriter(entry.Open())) writer.Write("{}");
+                    if (!link) { using var writer = new StreamWriter(zip.CreateEntry("FILE.json").Open()); writer.Write("{}"); }
+                }
+                Assert.Throws<InvalidDataException>(() => NetworkPackageArchive.Extract(memory.ToArray(), root));
+            }
+        }
+        finally { if (Directory.Exists(root)) Directory.Delete(root, true); }
+    }
+    [Fact]
+    public async Task PendingCannotReadOrOfferAndApprovedPlayerCannotEnableUploads()
+    {
+        await using var fixture = await HostFixture.StartAsync();
+        await using var client = await fixture.ConnectAsync();
+        await HostFixture.AttachControllerAsync(client, 0);
+        foreach (var method in new[] { "pool.manifest", "pool.fetch", "pool.offer", "pool.ack" })
+            Assert.NotNull((await client.CallRawAsync(method, new JsonObject())).Error);
+        Assert.True((await fixture.AdminAsync(AdminOps.ConnectionAdmit, new JsonObject { ["connectionId"] = client.ConnectionId })).Ok);
+        Assert.Null((await client.CallRawAsync("pool.manifest", new JsonObject())).Error);
+        Assert.NotNull((await client.CallRawAsync("pool.offer", new JsonObject())).Error);
+        Assert.NotNull((await client.CallRawAsync("pool.transfer.policy", new JsonObject { ["allowGuestPacks"] = true })).Error);
+    }
+    [Fact]
+    public async Task CorruptOrOutOfOrderUploadCannotEnterPoolAndWrongFingerprintCannotAcknowledge()
+    {
+        await using var fixture = await HostFixture.StartAsync();
+        await using var client = await fixture.ConnectAsync();
+        await HostFixture.AttachControllerAsync(client, 0);
+        await fixture.AdminAsync(AdminOps.ConnectionAdmit, new JsonObject { ["connectionId"] = client.ConnectionId });
+        Assert.True((await fixture.AdminAsync("pool.transfer.policy", new JsonObject { ["allowGuestPacks"] = true, ["requireAlignment"] = true })).Ok);
+        var before = (await client.CallRawAsync("pool.manifest", new JsonObject())).Result!["fingerprint"]!.ToString();
+        Assert.NotNull((await client.CallRawAsync("pool.ack", new JsonObject { ["fingerprint"] = new string('0', 64) })).Error);
+        var bytes = new byte[] { 1, 2, 3 };
+        Assert.Null((await client.CallRawAsync("pool.offer", new JsonObject { ["package"] = new JsonObject {
+            ["id"] = "new-pack", ["digest"] = new string('0', 64), ["bytes"] = bytes.Length, ["sha256"] = NetworkPackageArchive.Hash(bytes) } })).Error);
+        Assert.NotNull((await client.CallRawAsync("pool.chunk", new JsonObject { ["offset"] = 0, ["data"] = Convert.ToBase64String(bytes), ["sha256"] = new string('0', 64) })).Error);
+        Assert.NotNull((await client.CallRawAsync("pool.chunk", new JsonObject { ["offset"] = 1, ["data"] = Convert.ToBase64String(bytes), ["sha256"] = NetworkPackageArchive.Hash(bytes) })).Error);
+        Assert.NotNull((await client.CallRawAsync("pool.commit", new JsonObject())).Error);
+        var after = (await client.CallRawAsync("pool.manifest", new JsonObject())).Result!["fingerprint"]!.ToString();
+        Assert.Equal(before, after);
+    }
+}
