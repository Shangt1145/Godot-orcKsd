diff --git a/src/Orc.Game/Effects/AuthoringAuraRuntime.cs b/src/Orc.Game/Effects/AuthoringAuraRuntime.cs
new file mode 100644
index 0000000..0e1127e
--- /dev/null
+++ b/src/Orc.Game/Effects/AuthoringAuraRuntime.cs
@@ -0,0 +1,104 @@
+using System.Runtime.CompilerServices;
+using System.Text.Json;
+using Orc.Cards;
+using Orc.Game.Board;
+using Orc.Game.Cards;
+using Orc.Game.Effects;
+
+namespace Orc.Game.Effects;
+
+/// <summary>Continuous authoring programs contribute through native aura collection, never permanent buffs.</summary>
+public static class AuthoringAuraRuntime
+{
+    private static readonly ConditionalWeakTable<object,HashSet<string>> Registered=new();
+    public static void Validate(JsonElement actions)
+    {
+        void Value(JsonElement e)
+        {
+            if(e.ValueKind==JsonValueKind.Number&&e.TryGetInt32(out _))return;
+            var expression=e.GetProperty("expr").GetString();
+            if(expression=="variable")return;
+            if(expression=="literal"){Value(e.GetProperty("value"));return;}
+            if(expression is "query" or "count"){Query(e.GetProperty("query"));return;}
+            if(expression=="read"&&e.GetProperty("of").GetString() is "self" or "candidate"&&e.GetProperty("path").GetString() is "attack" or "defense" or "cost" or "opCost" or "maxDefense" or "missingDefense")return;
+            throw new InvalidDataException("持续效果数值表达式尚未接入："+expression);
+        }
+        void Query(JsonElement q)
+        {
+            if(q.ValueKind==JsonValueKind.String)return;
+            foreach(var p in q.EnumerateObject())if(p.Name is not ("sel" or "side" or "zone" or "ref" or "where" or "filter" or "excludeSelf" or "includeAnchor"))throw new InvalidDataException("持续效果选靶参数尚未接入："+p.Name);
+            if(q.GetProperty("sel").GetString() is not ("self" or "all" or "ref" or "refAll" or "adjacent"))throw new InvalidDataException("持续效果不允许随机或交互选靶。");
+            if(q.TryGetProperty("zone",out var zone)&&zone.GetString() is not ("field" or "support" or "frontline" or "hand" or "deck"))throw new InvalidDataException("持续效果区域尚未接入。");
+            if(q.TryGetProperty("where",out var where))AuthoringRuntime.ValidateFilter(JsonSerializer.SerializeToElement(new{where}));
+            if(q.TryGetProperty("filter",out var filter))AuthoringRuntime.ValidateFilter(filter);
+        }
+        foreach(var action in actions.EnumerateArray())
+        {
+            var op=action.GetProperty("op").GetString();
+            if(op=="let"){Value(action.GetProperty("value"));continue;}
+            if(op=="sequence"){Validate(action.GetProperty("actions"));continue;}
+            if(op!="changeAttribute")throw new InvalidDataException("持续效果暂不支持此动作："+op);
+            if(action.GetProperty("property").GetString() is not ("attack" or "defense" or "opCost" or "cost"))throw new InvalidDataException("持续效果属性无效。");
+            if(action.GetProperty("mode").GetString() is not ("add" or "set"))throw new InvalidDataException("持续效果写入方式无效。");
+            Query(action.GetProperty("target"));Value(action.GetProperty("value"));
+        }
+    }
+    public static async Task RegisterAsync(Card host,object view,string actionsJson,CancellationToken ct)
+    {
+        var source=(view as CardEventView)?.Effect??host;
+        var keys=Registered.GetOrCreateValue(source);if(!keys.Add(actionsJson))return;
+        var environment=GameEnvironment.ResolveFor(host)??throw new InvalidOperationException("光环缺少对局环境。");
+        using var document=JsonDocument.Parse(actionsJson);var actions=document.RootElement.Clone();
+        foreach(var (name,field) in new[]{("attack",CardStatFields.Attack),("defense",CardStatFields.Defense),("opCost",CardStatFields.OperateCost),("cost",CardStatFields.DeployCost)})
+            environment.Auras.Register(new AuraDeclaration(host,field,(candidate,current)=>Evaluate(host,candidate,name,current,actions),source));
+        await environment.RerunAllCardsAsync(ct);
+    }
+    private static int Evaluate(Card host,Card candidate,string property,int initial,JsonElement actions)
+    {
+        var variables=new Dictionary<string,object?>();var result=initial;
+        void Execute(JsonElement list)
+        {
+            foreach(var a in list.EnumerateArray())
+            {
+                var op=a.GetProperty("op").GetString();
+                if(op=="let"){variables[a.GetProperty("name").GetString()!]=Value(a.GetProperty("value"));continue;}
+                if(op=="sequence"){Execute(a.GetProperty("actions"));continue;}
+                if(a.GetProperty("property").GetString()!=property||!Query(a.GetProperty("target")).Contains(candidate))continue;
+                var amount=Convert.ToInt32(Value(a.GetProperty("value")));result=a.GetProperty("mode").GetString()=="set"?amount:result+amount;
+            }
+        }
+        object? Value(JsonElement e)
+        {
+            if(e.ValueKind==JsonValueKind.Number)return e.GetInt32();
+            if(e.ValueKind==JsonValueKind.String)return e.GetString();
+            if(e.ValueKind is JsonValueKind.True or JsonValueKind.False)return e.GetBoolean();
+            return e.GetProperty("expr").GetString() switch {
+                "query"=>Query(e.GetProperty("query")),"variable"=>variables.GetValueOrDefault(e.GetProperty("name").GetString()!),
+                "count"=>Query(e.GetProperty("query")).Length,"literal"=>Value(e.GetProperty("value")),
+                "read"=>AuthoringRuntime.Int(e.TryGetProperty("of",out var of)&&of.GetString()=="candidate"?candidate:host,e.GetProperty("path").GetString()!),
+                _=>throw new InvalidDataException("持续效果数值表达式尚未接入。") };
+        }
+        Card[] Query(JsonElement q)
+        {
+            if(q.ValueKind==JsonValueKind.String)return q.GetString()=="self"?[host]:variables.GetValueOrDefault(q.GetString()!) as Card[]??[];
+            var sel=q.GetProperty("sel").GetString();Card[] cards;
+            if(sel=="self")cards=[host];
+            else if(sel is "ref" or "refAll")cards=q.GetProperty("ref").GetString()=="self"?[host]:variables.GetValueOrDefault(q.GetProperty("ref").GetString()!) as Card[]??[];
+            else if(sel=="adjacent")cards=AuthoringRuntime.Adjacent(variables.GetValueOrDefault(q.GetProperty("ref").GetString()!) as Card[]??[host],q.TryGetProperty("includeAnchor",out var include)&&include.GetBoolean());
+            else
+            {
+                var match=EffectRuntime.MatchFor(host)!;var zone=q.TryGetProperty("zone",out var z)?z.GetString():"field";
+                var side=q.TryGetProperty("side",out var s)?s.GetString():"friendly";var owner=AuthoringRuntime.Owner(host);
+                if(zone is "hand" or "deck")cards=AuthoringRuntime.Pile(host,side??"friendly",zone);
+                else cards=match.Players.Where(p=>side is "both" or "any"||(side=="enemy"?p!=owner:p==owner))
+                    .SelectMany(p=>zone=="frontline"?match.Battlefield.FrontLine.Members.Where(c=>AuthoringRuntime.Owner(c)==p):zone=="support"?match.Battlefield.GetSupportLine(p).Members:match.Battlefield.GetSupportLine(p).Members.Concat(match.Battlefield.FrontLine.Members.Where(c=>AuthoringRuntime.Owner(c)==p)))
+                    .Where(c=>c is UnitCard).Distinct().ToArray();
+            }
+            if(q.TryGetProperty("where",out var where))cards=cards.Where(c=>AuthoringRuntime.Matches(c,JsonSerializer.Serialize(new {where}))).ToArray();
+            if(q.TryGetProperty("filter",out var filter))cards=cards.Where(c=>AuthoringRuntime.Matches(c,filter.GetRawText())).ToArray();
+            if(q.TryGetProperty("excludeSelf",out var exclude)&&exclude.GetBoolean())cards=cards.Where(c=>!ReferenceEquals(c,host)).ToArray();
+            return cards;
+        }
+        Execute(actions);return result;
+    }
+}
diff --git a/src/Orc.Game/Effects/AuthoringRuntime.cs b/src/Orc.Game/Effects/AuthoringRuntime.cs
new file mode 100644
index 0000000..cf4bc89
--- /dev/null
+++ b/src/Orc.Game/Effects/AuthoringRuntime.cs
@@ -0,0 +1,269 @@
+using System.Text.Json;
+using Orc.Cards;
+using Orc.Game;
+using Orc.Game.Cards;
+using Orc.Game.Effects;
+using Orc.Game.Players;
+using Orc.Game.Targeting;
+using Orc.Core;
+using System.Runtime.CompilerServices;
+
+namespace Orc.Game.Effects;
+
+/// <summary>Authoring adapters invoke the native match's services and modifiers.</summary>
+public static class AuthoringRuntime
+{
+    private static readonly ConditionalWeakTable<object, Dictionary<string,int>> Uses = new();
+    public static Card? EventCard(object view) => view switch {
+        CardEventView e => e.Unit as Card ?? e.Card as Card,
+        Orc.Game.Commanding.UnitAttackTriggerView a => a.Attacker?.Value as Card, _ => null };
+    public static Card? EventTarget(object view) => view is Orc.Game.Commanding.UnitAttackTriggerView attack ? attack.Target?.Value as Card : EventCard(view);
+    public static bool ShouldRun(Card host, object view, string graph)
+    {
+        using var doc=JsonDocument.Parse(graph);var effect=doc.RootElement;
+        var trigger=effect.GetProperty("trigger").GetString();
+        var actor=EventCard(view);var owner=view is CardEventView e&&e.Player is Player player?player:actor is null?null:Owner(actor);
+        var side=effect.TryGetProperty("eventSide",out var eventSide)?eventSide.GetString():effect.TryGetProperty("watchOpponent",out var opponent)&&opponent.GetBoolean()?"enemy":trigger is "turnStart" or "turnEnd" or "unitDeployed" or "unitUpgraded" or "orderPlayed" or "friendlyDeath" or "friendlyDamaged"?"friendly":"any";
+        if(side is "self" or "friendly" && owner!=Owner(host)||side is "enemy" or "foe"&&owner==Owner(host))return false;
+        if(effect.TryGetProperty("selfOnly",out var selfOnly)&&selfOnly.GetBoolean()&&!ReferenceEquals(actor,host))return false;
+        if(effect.TryGetProperty("filter",out var filter)&&(actor is null||!MatchFilter(actor,filter)))return false;
+        if(trigger=="orderPlayed"&&actor is not OrderCard)return false;
+        if(effect.TryGetProperty("listenZone",out var zone)&&zone.GetString() is {Length:>0} selected&&selected is not ("any" or "board" or "field"))throw new InvalidDataException("监听区域尚未接入："+selected);
+        if(effect.TryGetProperty("once",out var once)&&once.GetBoolean()||effect.TryGetProperty("oncePerTurn",out var perTurn)&&perTurn.GetBoolean())
+        {
+            var key=graph;var uses=Uses.GetOrCreateValue((view as CardEventView)?.Effect??host);var turn=Match(host).TurnNumber;
+            if(uses.TryGetValue(key,out var previous)&&(once.ValueKind==JsonValueKind.True||previous==turn))return false;
+            uses[key]=turn;
+        }
+        return true;
+    }
+    private static Match Match(Card source) => EffectRuntime.MatchFor(source) ?? throw new InvalidOperationException("效果没有连接到对局。");
+    public static Player Owner(Card source) => source switch { CardBase c when c.Owner is not null => c.Owner, Hq h => h.Owner, _ => throw new InvalidOperationException("效果没有归属玩家。") };
+    public static Card Viewer(Card source, string side) => side is "enemy" or "foe" ? Match(source).Players.Single(p => p != Owner(source)).Hq : Owner(source).Hq;
+    public static int Random(Card source, int min, int max)
+    {
+        if (max < min || (long)max - min >= int.MaxValue) throw new InvalidDataException("随机数范围无效。");
+        return min + Match(source).RandomService.Next(max - min + 1);
+    }
+    public static Card[] Pick(Card source, Card[] candidates, string selection, int count)
+    {
+        count = Math.Clamp(count, 0, candidates.Length);
+        return selection switch { "random" => Match(source).RandomService.PickN(candidates, count).ToArray(), "first" => candidates.Take(count).ToArray(), "last" => candidates.Reverse().Take(count).ToArray(), _ => candidates };
+    }
+    public static Card[] Pile(Card source, string side, string zone)
+    {
+        var players = side is "both" or "any" ? Match(source).Players : new[] { Owner(Viewer(source, side)) };
+        return players.SelectMany(p => zone == "hand" ? p.Hand.Cast<Card>()
+            : Enumerable.Range(0, p.Deck.Count).Select(i => (Card)p.Deck.PeekInstance(i))).ToArray();
+    }
+    public static async Task<Card[]> DrawSpecificAsync(Card source, Card[] candidates, CancellationToken ct)
+    {
+        // A filtered draw takes one card, with the same burn/events rules as an ordinary draw.
+        var card=candidates.FirstOrDefault(c=>c is CardBase b&&b.Owner is { } p&&Enumerable.Range(0,p.Deck.Count).Any(i=>ReferenceEquals(p.Deck.PeekInstance(i),c)));
+        if(card is null)return [];
+        await Match(source).EffectRuntime.FetchFromDeckAsync(card,ct,source);
