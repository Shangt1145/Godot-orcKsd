+﻿using System.Runtime.CompilerServices;
+using System.Text.Json;
+using Orc.Cards;
+using Orc.Core;
+using Orc.Game;
+using Orc.Game.Cards;
+using Orc.Game.Effects;
+using Orc.Game.Players;
+using Orc.Game.Targeting;
+using Orc.Game.Triggers;
+
+
+namespace Orc.Game.Effects;
+
+public sealed record AuthoringSelectorTag(string SlotName);
+
+/// <summary>Declarative targets use native pre-play capture and TargeterManager, never "first unit".
+/// This bridge owns references and selector transport only; the engine owns admission and mutation.</summary>
+public sealed class AuthoringTargetContext : IDisposable
+{
+    private static readonly ConditionalWeakTable<Player,AuthoringTargetContext> Owners=new();
+    private readonly ConditionalWeakTable<Card,Dictionary<string,Card[]>> _captured=new();
+    private readonly ConditionalWeakTable<Card,HashSet<string>> _consumed=new();
+    /// <summary>每个目标声明 id 最近一次真正选中的结果。跨效果回指（「将其消灭」）靠它，
+    /// 否则第二段会自己再发起一次选靶——回合结束这类非交互时机没人应答，效果就静默消失。</summary>
+    private readonly ConditionalWeakTable<Card,Dictionary<string,Card[]>> _recent=new();
+    private readonly List<(Orc.Core.Trigger<CardTriggerView> Trigger,TriggerRegistration Handle)> _registrations=[];
+    private readonly Match _match;
+    private readonly IReadOnlyDictionary<string,string[]> _plans;
+    private readonly ConditionalWeakTable<Card,object> _prepared=new();
+    public AuthoringTargetContext(Match match,IReadOnlyDictionary<string,string[]> plans)
+    {
+        _match=match;_plans=plans;
+        foreach(var owner in match.Players)Owners.Add(owner,this);
+        foreach(var card in match.Players.SelectMany(p=>p.Hand.OfType<CardBase>().Concat(Enumerable.Range(0,p.Deck.Count).Select(p.Deck.PeekInstance))))
+            PrepareCard(card);
+    }
+    /// <summary>Also called before playing dynamically created copies, which did not exist at setup.</summary>
+    public void PrepareCard(CardBase card)
+    {
+        if(_prepared.TryGetValue(card,out _))return;
+        _prepared.Add(card,new object());
+        {
+            if(!_match.CardLibrary.TryGetRegisteredId(card.Definition,out var id)||!_plans.TryGetValue(id,out var graphs))return;
+            var declarations=graphs.SelectMany(g=>
+            {
+                using var d=JsonDocument.Parse(g);var e=d.RootElement;
+                if(!HasInteractivePlayEffect(card,Text(e,"trigger")))return [];
+                // reuse＝跨效果回指（「将其消灭」）：它在执行时取上一次选中的目标，
+                // 打出前不额外问玩家一次，否则同一张卡会连问两遍。
+                return Text(e,"trigger") is "deploy" or "play" or "order"&&e.TryGetProperty("targets",out var targets)
+                    ?targets.EnumerateArray().Where(t=>!(t.TryGetProperty("reuse",out var r)&&r.ValueKind==JsonValueKind.True))
+                        .Select(t=>(Declaration:t.GetRawText(),Scope:Scope(e),Trigger:Text(e,"trigger"))).ToArray():[];
+            }).Distinct().ToArray();
+            if(declarations.Length==0)return;
+            var trigger=card switch{UnitCard unit=>unit.PrePlayTrigger,OrderCard command=>command.PrePlayTrigger,_=>null};
+            if(trigger is null)return;
+            var handle=trigger.Register("desktop/capture",async(view,_,ct)=>
+            {
+                _captured.Remove(card);_consumed.Remove(card);var selection=new Dictionary<string,Card[]>(StringComparer.Ordinal);
+                foreach(var declaration in declarations)
+                {
+                    // 部署指向的目标池要含**这张单位牌自己**：预打出时它还在手牌，
+                    // 引擎查询只能看到旧场面，于是「使 1 个友方单位…」在空场时连自己都选不到。
+                    var includeSource=declaration.Trigger=="deploy"&&card is UnitCard;
+                    using var target=JsonDocument.Parse(declaration.Declaration);
+                    if((await ResolveCandidates(card,target.RootElement,ct,includeSource)).Count==0)continue;
+                    var result=await SelectCore(card,declaration.Declaration,ct,includeSource);
+                    // 有候选却拿不到结果＝玩家取消：放弃这次打出（零副作用）。
+                    // CaptureBox 只存在于工坊预览，真实对局里它是 null——此前无条件解引用会抛 NRE，
+                    // 而事件总线会静默吞掉订阅者异常，表现为"卡已扣费但什么都没发生"。
+                    if(result.Length==0){view.CaptureBox?.CancelPrePlay();return;}
+                    selection[declaration.Scope+"|"+declaration.Declaration]=result;
+                }
+                _captured.Add(card,selection);_consumed.Add(card,new());
+            });
+            _registrations.Add((trigger,handle));
+        }
+    }
+    public static void ValidateTarget(JsonElement target)
+    {
+        var allowed=new[]{"id","kind","side","zone","prompt","filter","reuse"};
+        if(string.IsNullOrWhiteSpace(Text(target,"id")))throw new InvalidDataException("声明目标必须具有唯一 id");
