+        });ct.ThrowIfCancellationRequested();return outcome.IsOk&&selected is not null?Array.IndexOf(identifiers,selected):-1;
+    }
+    public static async Task<Card[]> DevelopAsync(Card source,string[] definitions,string side,bool random,CancellationToken ct)
+    {
+        var match=Match(source);var offers=(definitions.Length==0?match.CardService.RegisteredDefinitions.Where(p=>!p.Value.Tags.Contains("token")&&!p.Value.Tags.Contains("reserved")).Select(p=>p.Key):definitions).Distinct().ToArray();
