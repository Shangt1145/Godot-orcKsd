+            if(value.GetProperty("expr").GetString()!="read"||value.TryGetProperty("of",out var who)&&who.GetString() is not ("candidate" or "current"))throw new InvalidDataException("筛选表达式尚未接入。");
+            if(value.GetProperty("path").GetString() is not ("attack" or "defense" or "cost" or "opCost" or "maxDefense" or "missingDefense" or "unitType" or "cardType" or "set" or "name" or "keywords" or "extraTypes"))throw new InvalidDataException("筛选属性尚未接入。");
+        }
+    }
+    private static bool MatchFilter(Card c, JsonElement f)
+    {
+        if (f.TryGetProperty("where", out var where) && !Test(c, where)) return false;
+        foreach (var p in f.EnumerateObject())
+        {
+            if (p.Name == "where") continue;
+            if (p.Name is "minCost" or "maxCost" or "minAttack" or "maxAttack" or "minDefense" or "maxDefense")
+            { var property = char.ToLowerInvariant(p.Name[3]) + p.Name[4..]; var value = Int(c, property); if (p.Name.StartsWith("min") ? value < p.Value.GetInt32() : value > p.Value.GetInt32()) return false; }
+            else if (p.Name == "unitType") { if (c is not CardBase card || !card.Definition.UnitTypes.Contains(p.Value.GetString()!)) return false; }
+            else if (p.Name == "keyword") { if (c is not CardBase card || !card.Keywords.Has(Keyword(p.Value.GetString()!))) return false; }
+            else if (p.Name == "nameIncludes") { if(!c.Name.Contains(p.Value.GetString()!,StringComparison.Ordinal))return false; }
+            else throw new InvalidDataException("尚未接入筛选条件：" + p.Name);
+        }
+        return true;
+    }
+    public static string Keyword(string key)
+    {
+        if(key=="armor")return KeywordIds.Armor;
+        if(key=="intel")return KeywordIds.Intelligence;
+        return Orc.Game.Cards.Data.CardAttributeMap.TryMap(key,out var declaration)?declaration.Id:key;
+    }
+    private static object? Read(JsonElement value, Card candidate)
+    {
+        if (value.ValueKind == JsonValueKind.String) return value.GetString();
+        if (value.ValueKind == JsonValueKind.Number) return value.GetDouble();
+        if (value.ValueKind is JsonValueKind.True or JsonValueKind.False) return value.GetBoolean();
+        var path = value.GetProperty("path").GetString()!;
+        if(path=="extraTypes")return (candidate as CardBase)?.Definition.UnitTypes.ToArray()??[];
+        if(path=="keywords")return candidate is CardBase card?card.Keywords.Components.Select(k=>k.Keyword).ToArray():Array.Empty<string>();
+        return path is "unitType" or "cardType" or "set" or "name" ? Text(candidate, path) : (object)(double)Int(candidate, path);
+    }
+    private static bool Test(Card c, JsonElement test)
+    {
+        var kind = test.GetProperty("test").GetString();
+        if (kind == "all") return test.GetProperty("items").EnumerateArray().All(t => Test(c, t));
+        if (kind == "any") return test.GetProperty("items").EnumerateArray().Any(t => Test(c, t));
+        if (kind == "not") return !Test(c, test.GetProperty("item"));
+        var left = Read(test.GetProperty("left"), c); var right = Read(test.GetProperty("right"), c);
+        if(test.GetProperty("left").ValueKind==JsonValueKind.Object&&test.GetProperty("left").TryGetProperty("path",out var attribute)&&attribute.GetString()=="set"&&right is string faction&&Faction.TryNormalize(faction,out var canonical))right=canonical;
+        return test.GetProperty("cmp").GetString() switch { "contains"=>left is string[] items&&right is string item&&items.Contains(Keyword(item)),"==" => Equals(left, right), "!=" => !Equals(left, right),
+            ">" => Convert.ToDouble(left) > Convert.ToDouble(right), ">=" => Convert.ToDouble(left) >= Convert.ToDouble(right),
+            "<" => Convert.ToDouble(left) < Convert.ToDouble(right), "<=" => Convert.ToDouble(left) <= Convert.ToDouble(right),
+            _ => throw new InvalidDataException("尚未接入筛选比较。") };
+    }
+}
