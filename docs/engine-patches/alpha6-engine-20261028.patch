+            while(step.IsFailed&&step.Failure==SelectorFailureReason.InvalidSelection)step=await flow.Retry<IReadOnlyList<Ref<Entity>>>();
+            if(step.IsCancelled)return TargeterResult.Cancelled();
+            if(!step.IsOk)return TargeterResult.FromSelectorFailure(step.Failure);
+            chosen=step.Value!.Select(r=>(Card)r.Value).ToArray();return TargeterResult.Ok();
+        });
+        ct.ThrowIfCancellationRequested();return outcome.IsOk?chosen:[];
+    }
+    public static async Task<int> ChooseOptionAsync(Card source,string[] options,CancellationToken ct)
+    {
+        string? selected=null;var identifiers=options.Select((label,index)=>index+":"+label).ToArray();
+        var outcome=await Match(source).TargeterManager.RunAsync(async flow=>{
+            var step=await flow.Step(SelectorTemplates.Option,new IdentifierSetParameter(identifiers,1,1){Owner=Owner(source),Action=SelectorActions.Effect});
