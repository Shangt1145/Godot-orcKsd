@@ -0,0 +1,50 @@
+using System.Text.Json.Nodes;
+using Orc.Client;
+using Orc.Server.Admin;
+using Xunit;
+
+namespace Orc.Server.Tests;
+
+/// <summary>
+/// 入场信号：<c>notify/match.started</c> 必须真的发出去，而且**先于第一帧视图**。
+/// <para>
+/// 没有它，客户端只能靠"第一帧 notify/view"判断对局开始了；慢半拍的客户端拿到的那一帧
+/// 可能已经是 play 相位，换牌阶段就被整段跳过（2026-10-24 实机复现：房主换完牌，客机才进场）。
+/// </para>
+/// </summary>
+public sealed class MatchStartedNoticeTests
+{
+    private static async Task Admit(HostFixture fixture, OrcClient client, int seat)
+    {
+        await HostFixture.AttachControllerAsync(client, seat);
+        Assert.True((await fixture.AdminAsync(AdminOps.ConnectionAdmit,
+            new JsonObject { ["connectionId"] = client.ConnectionId })).Ok);
+    }
+
+    [Fact]
+    public async Task BothSeatsReceiveMatchStarted_BeforeTheirFirstView()
+    {
+        await using var fixture = await HostFixture.StartAsync();
+        await using var host = await fixture.ConnectAsync();
+        await using var guest = await fixture.ConnectAsync();
+        await using var hostNotes = new NotificationCollector(host);
+        await using var guestNotes = new NotificationCollector(guest);
+
+        await Admit(fixture, host, 0);
+        await Admit(fixture, guest, 1);
+
+        Assert.True((await fixture.AdminAsync(AdminOps.MatchStart)).Ok);
+
+        var started = await guestNotes.WaitAsync("notify/match.started");
+        Assert.False(string.IsNullOrWhiteSpace(started.Params?["roomId"]?.GetValue<string>()));
+        Assert.True(hostNotes.Has("notify/match.started"), "房主侧没收到 match.started");
+
+        // 换牌面板靠"先入场再收帧"才能弹出，所以顺序是被断言的契约，不是巧合。
+        var received = guestNotes.Received.ToList();
+        var startedAt = received.FindIndex(n => n.Method == "notify/match.started");
+        var firstViewAt = received.FindIndex(n => n.Method == "notify/view");
+        Assert.True(startedAt >= 0, "客人没收到 match.started");
+        Assert.True(firstViewAt < 0 || startedAt < firstViewAt,
+            $"match.started 落在了第一帧视图之后（started={startedAt}, view={firstViewAt}）");
+    }
+}
