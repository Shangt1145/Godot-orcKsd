@@ -0,0 +1,24 @@
+using Orc.Cards;
+
+namespace Orc.Game.Cards;
+
+/// <summary>Smoke protects support units until they advance or attack; it is not covert.</summary>
+public static class SmokeScreenRules
+{
+    internal static bool CanGrant(Card card, KeywordLoadContext? context) =>
+        !card.TryGetData<UnitStateData>(out var state) || state.Line is null
+        || context?.Battlefield is not { } battlefield || !ReferenceEquals(state.Line, battlefield.FrontLine);
+
+    internal static Task RemoveOnFrontAsync(UnitCard unit, CancellationToken ct = default) =>
+        CanGrant(unit, unit.Keywords.LoadContextProvider?.Invoke()) ? Task.CompletedTask : RemoveAsync(unit, ct);
+
+    /// <summary>Drop the runtime keyword and publish its change for local and remote projections.</summary>
+    public static async Task RemoveAsync(UnitCard unit, CancellationToken ct = default)
+    {
+        if (!unit.TryGetData<UnitStateData>(out var state) || state.IsDestroyed
+            || !unit.Keywords.Has(KeywordIds.SmokeScreen)) return;
+        if (await unit.Keywords.RevokeAsync(KeywordIds.SmokeScreen).ConfigureAwait(false)
+            && unit.Keywords.LoadContextProvider?.Invoke() is { } context)
+            await GameUpdates.EmitCardStatChanged(context.Engine, unit, ["keywords"], ct).ConfigureAwait(false);
+    }
+}
