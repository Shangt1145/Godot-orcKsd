+    }
+    public static bool Matches(Card candidate, string json)
+    {
+        using var document = JsonDocument.Parse(json); return MatchFilter(candidate, document.RootElement);
+    }
+    public static void ValidateFilter(JsonElement filter)
+    {
+        foreach(var p in filter.EnumerateObject())
+        {
+            if(p.Name is "minCost" or "maxCost" or "minAttack" or "maxAttack" or "minDefense" or "maxDefense") { if(!p.Value.TryGetInt32(out _))throw new InvalidDataException("筛选阈值必须为整数。"); }
+            else if(p.Name is "unitType" or "keyword" or "nameIncludes") { if(p.Value.ValueKind!=JsonValueKind.String)throw new InvalidDataException("筛选名称必须为文字。"); }
